<Window x:Class="KahrimanVolumeMixer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayarlar — KAHRIMAN VOLUME MIXER"
        Width="340" Height="600"
        MinWidth="300" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16,8,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,6,0">

                <TextBlock Text="FARE TEKERLEĞİ" Style="{StaticResource SectionHeader}"/>
                <CheckBox x:Name="SmartAccelerationCheck" Content="Akıllı hızlandırma (dönüş hızına göre adım)"/>

                <TextBlock x:Name="WheelStepLabel" Style="{StaticResource SettingLabel}"/>
                <Slider x:Name="WheelStepSlider" Minimum="0.5" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True"/>

                <TextBlock x:Name="SlowStepLabel" Style="{StaticResource SettingLabel}"/>
                <Slider x:Name="SlowStepSlider" Minimum="0.5" Maximum="5" TickFrequency="0.5" IsSnapToTickEnabled="True"/>

                <TextBlock x:Name="NormalStepLabel" Style="{StaticResource SettingLabel}"/>
                <Slider x:Name="NormalStepSlider" Minimum="1" Maximum="15" TickFrequency="0.5" IsSnapToTickEnabled="True"/>

                <TextBlock x:Name="FastStepLabel" Style="{StaticResource SettingLabel}"/>
                <Slider x:Name="FastStepSlider" Minimum="2" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"/>

                <TextBlock Text="SES GEÇİŞİ" Style="{StaticResource SectionHeader}"/>
                <CheckBox x:Name="SmoothCheck" Content="Yumuşak ses geçişi"/>
                <TextBlock x:Name="TransitionLabel" Style="{StaticResource SettingLabel}"/>
                <Slider x:Name="TransitionSlider" Minimum="20" Maximum="500" TickFrequency="10" IsSnapToTickEnabled="True"/>

                <TextBlock Text="SEVİYELER" Style="{StaticResource SectionHeader}"/>
                <TextBlock x:Name="LowLabel" Style="{StaticResource SettingLabel}"/>
                <Slider x:Name="LowSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"/>
                <TextBlock x:Name="HighLabel" Style="{StaticResource SettingLabel}"/>
                <Slider x:Name="HighSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"/>

                <TextBlock Text="PENCERE" Style="{StaticResource SectionHeader}"/>
                <CheckBox x:Name="TopmostCheck" Content="Her zaman üstte (Always on Top)"/>
                <CheckBox x:Name="StartupCheck" Content="Windows başlangıcında çalıştır"/>

                <TextBlock Text="Tema" Style="{StaticResource SettingLabel}"/>
                <ComboBox x:Name="ThemeCombo" Margin="0,0,0,2">
                    <ComboBoxItem Content="Koyu"/>
                    <ComboBoxItem Content="Açık"/>
                </ComboBox>

                <TextBlock x:Name="OpacityLabel" Style="{StaticResource SettingLabel}"/>
                <Slider x:Name="OpacitySlider" Minimum="30" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"/>

                <TextBlock x:Name="PathText" Margin="0,16,0,0" FontSize="10" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubTextBrush}"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource PillButton}" Content="Varsayılanlar" Width="100" Margin="0,0,8,0"
                    Click="DefaultsButton_Click"/>
            <Button Style="{StaticResource PillButton}" Content="Kapat" Width="80" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
