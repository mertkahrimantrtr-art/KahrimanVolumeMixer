<Window x:Class="KahrimanVolumeMixer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:KahrimanVolumeMixer.Controls"
        Title="KAHRIMAN VOLUME MIXER"
        Width="100" Height="300"
        MinWidth="76" MinHeight="200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder"
            CornerRadius="12"
            Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            PreviewMouseWheel="RootBorder_PreviewMouseWheel"
            PreviewMouseDown="RootBorder_PreviewMouseDown">
        <Grid Margin="6,4,6,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="22"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Başlık çubuğu: sürükleyerek taşı -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                  ToolTip="Sürükleyerek taşı">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Grid.Column="0" Width="7" Height="7" Margin="3,0,0,0"
                         VerticalAlignment="Center" Fill="{DynamicResource OffBrush}"/>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE713;"
                        ToolTip="Ayarlar" Click="SettingsButton_Click"/>
                <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE921;"
                        ToolTip="Sistem tepsisine küçült" Click="MinimizeButton_Click"/>
                <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE8BB;"
                        ToolTip="Kapat (Chrome sesi korunur)" Click="CloseButton_Click"/>
            </Grid>

            <!-- Büyük yüzde göstergesi -->
            <Viewbox Grid.Row="1" Height="34" Stretch="Uniform" StretchDirection="Both" Margin="2,2,2,0">
                <TextBlock x:Name="PercentText" Text="75%" FontSize="30" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"/>
            </Viewbox>

            <TextBlock x:Name="StatusText" Grid.Row="2" Text="CHROME" FontSize="9" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"
                       TextTrimming="CharacterEllipsis"/>

            <controls:FaderControl x:Name="Fader" Grid.Row="3" Margin="0,6,0,6"
                                   ToolTip="Tekerlek: ses • Sürükle: ayarla • Orta tuş: sessiz"/>

            <StackPanel Grid.Row="4">
                <UniformGrid Columns="2" Margin="0,0,0,4">
                    <Button x:Name="LowButton" Style="{StaticResource PillButton}" Content="LOW" Margin="0,0,2,0"
                            Padding="0" Click="LowButton_Click" MouseRightButtonUp="LowButton_MouseRightButtonUp"/>
                    <Button x:Name="HighButton" Style="{StaticResource PillButton}" Content="HIGH" Margin="2,0,0,0"
                            Padding="0" Click="HighButton_Click" MouseRightButtonUp="HighButton_MouseRightButtonUp"/>
                </UniformGrid>
                <Button x:Name="MuteButton" Style="{StaticResource PillButton}" Click="MuteButton_Click"
                        ToolTip="Sessize al / aç (orta tuş)">
                    <TextBlock x:Name="MuteGlyph" FontFamily="{StaticResource IconFont}" FontSize="13" Text="&#xE767;"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
